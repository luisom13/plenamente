# Copia este archivo como .env.local y completa los valores reales.

# Número de WhatsApp que recibe las solicitudes de cita (opcional: ya hay uno por defecto en src/lib/site.ts).
# Formato internacional, solo dígitos, sin "+" ni espacios (503 = El Salvador).
NEXT_PUBLIC_WHATSAPP_NUMBER=50362675286

# URL pública del sitio (se usa para las etiquetas Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com
